node_modules/

# Game files: downloaded with "npm run fetch-game", never committed.
/game/
/game.previous/
/game.download/
# Sad Burst 2 ("npm run fetch-game -- --sadburst").
/game.sadburst/
/game.sadburst.previous/
/game.sadburst.download/

# Local data (docs/operations/running.md, "Local data"): settings, logins, saved maps,
# servers, testers, network logs, fingerprinters, screenshots, the generated names.js and
# opcodes.js, feature flags, and the private server's settings, certificate and bans.
# Only the *.example.json templates are tracked.
/data/*
!/data/*.example.json
!/data/server/
/data/server/*
!/data/server/*.example.json

# The folders local data lived in before data/; the app moves what is left there into data/.
/desktop/
/server/
/netlogs/
/fingerprint/
/fingerprint.sadburst/
/screenshots/
/features.json

# Your hooks (see docs/features/hooks.md). The *.example.js templates are tracked.
/hooks/*
!/hooks/*.example.js

# Build output ("npm run build").
/dist/

# Packaged apps ("npm run release").
/release/

node_modules/

# Game files: downloaded with "npm run fetch-game", never committed.
/game/
/game.previous/
/game.download/
# Sad Burst 2 ("npm run fetch-game -- --sadburst"), desktop/clients.js.
/game.sadburst/
/game.sadburst.previous/
/game.sadburst.download/

# Generated from the game files with "npm run find-names".
desktop/dev/names.js
desktop/dev/names.sadburst.js

# The map editor's trigger action names, from "npm run fetch-opcodes".
desktop/dev/opcodes.js
desktop/dev/opcodes.sadburst.js

# Screenshots taken with the dev console's "screenshot"
/screenshots/

# Local settings
desktop/credentials.json*
desktop/dev-overrides.json
desktop/dev-overrides.sadburst.json
desktop/maps.sadburst/
desktop/maps/*

# Your hooks (see hooks/README.md). The guide, the reference and the *.example.js templates are tracked.
/hooks/*
!/hooks/README.md
!/hooks/REFERENCE.md
!/hooks/*.example.js

# Remote play (desktop/remote/): tester links, and each tester's console settings.
desktop/remote-testers.json
desktop/remote-data/

# The player-hosted dedicated host (desktop/p2p-host/): its settings (they hold the match password) and its console settings.
desktop/p2p-host.json
desktop/server.json
desktop/p2p-host-overrides.json

# The server list's private servers (desktop/servers.js): addresses, your nicknames, their passwords.
desktop/servers.json
desktop/servers.json.tmp
desktop/join.json

# Your own server (server/): its settings, and its certificate, bans and downloaded maps.
server/server.json
server/data/

# Network logs from the dev console's recorder (console key net_log), one file per run and game instance.
/netlogs/

# The main server's fingerprinter, every version once (desktop/fingerprint.js, console "fingerprint").
/fingerprint/
/fingerprint.sadburst/

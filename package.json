{
  "name": "plazma-burst-2-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for the Plazma Burst 2 HTML5 game, with a dev console",
  "main": "src/wrapper/main.ts",
  "scripts": {
    "build": "node src/tools/build/cli.ts",
    "build:watch": "node src/tools/build/cli.ts --watch",
    "start": "npm run build && electron .",
    "start:verbose": "npm run build && electron . --verbose",
    "sadburst": "npm run build && electron . --sadburst",
    "host": "npm run build && electron . --host",
    "p2p-host": "npm run build && electron . --p2p-host",
    "server": "node src/server/index.ts",
    "fetch-game": "node src/tools/fetch-game/cli.ts",
    "find-names": "node src/tools/find-names/cli.ts",
    "fetch-opcodes": "node src/tools/fetch-opcodes/cli.ts",
    "testers": "node src/features/remote_play/testers.ts",
    "check": "tsc --noEmit -p .",
    "lint": "eslint --max-warnings 0 src",
    "test": "node --test 'src/**/*.test.ts' 'src/**/*.test.mjs'",
    "verify": "npm run lint && npm run check && npm test && npm run build",
    "smoke": "npm run build && node src/tools/smoke/cli.ts",
    "redact-netlogs": "node src/tools/redact-netlogs/cli.ts"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "electron": "^45.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.1",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  }
}

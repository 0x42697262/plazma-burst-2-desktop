{
  "name": "plazma-burst-2-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for the Plazma Burst 2 HTML5 game, with a dev console",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "start:verbose": "electron . --verbose",
    "fetch-game": "node tools/fetch-game.js",
    "find-names": "node tools/find-names.js",
    "fetch-opcodes": "node tools/fetch-opcodes.js",
    "test": "node --test test/",
    "host": "electron . --host",
    "testers": "node tools/remote-testers.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
